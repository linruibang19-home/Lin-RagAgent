{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.kuritian.online/api/:path*"
    },
    {
      "source": "/manage/:path*",
      "destination": "https://api.kuritian.online/manage/:path*"
    },
    {
      "source": "/admin/auth/:path*",
      "destination": "https://api.kuritian.online/admin/auth/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
